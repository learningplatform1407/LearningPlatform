{
  "permissions": {
    "deny": [
      "Read(./**/.envrc)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/check_wildcard_imports.py\"",
            "statusMessage": "Checking for wildcard imports..."
          }
        ]
      }
    ]
  }
}
